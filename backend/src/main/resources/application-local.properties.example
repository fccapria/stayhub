# ==============================================================================
# StayHub - Spring Boot Local Profile Example (application-local.properties.example)
# ==============================================================================
# Copy this file to 'application-local.properties' to customize local development:
# cp src/main/resources/application-local.properties.example src/main/resources/application-local.properties
# Run Spring Boot with: ./mvnw spring-boot:run -Dspring-boot.run.profiles=local
# ==============================================================================

# Database
# spring.datasource.url=jdbc:mariadb://localhost:3306/stayhub?createDatabaseIfNotExist=true
# spring.datasource.username=stayhub_user
# spring.datasource.password=stayhub_password

# Email / Google App Password
# spring.mail.username=your_email@gmail.com
# spring.mail.password=your_app_password
# stayhub.mail.from=StayHub Reservations <your_email@gmail.com>

# PayPal Sandbox
# paypal.client-id=your_sandbox_client_id
# paypal.client-secret=your_sandbox_client_secret
