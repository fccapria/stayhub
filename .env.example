# ==============================================================================
# StayHub - Environment Configuration Template (.env.example)
# ==============================================================================
# Istruzioni:
# 1. Copia questo file in '.env' nella root del progetto:
#    cp .env.example .env
# 2. Compila i valori sensibili (credenziali SMTP, credenziali PayPal, ecc.)
# 3. Il file '.env' è escluso da Git per motivi di sicurezza (.gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TOPOLOGIA DI RETE & PORTE DEI SERVIZI
# ------------------------------------------------------------------------------
FRONTEND_PORT=4200
BACKEND_PORT=8080
KEYCLOAK_PORT=9000
WIREMOCK_PORT=8089
MARIADB_PORT=3306

FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:8080
KEYCLOAK_URL=http://localhost:9000

# ------------------------------------------------------------------------------
# 2. DATABASE (MariaDB Docker & Spring Boot Datasource)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=stayhub
DB_USER=stayhub_user
DB_PASSWORD=stayhub_password
MARIADB_ROOT_PASSWORD=stayhub_root_password

# ------------------------------------------------------------------------------
# 3. IDENTITY PROVIDER (Keycloak 24.0.2 - Realm stayhub)
# ------------------------------------------------------------------------------
KEYCLOAK_AUTH_SERVER_URL=http://localhost:9000
KEYCLOAK_REALM=stayhub
KEYCLOAK_CLIENT_ID=stayhub-frontend
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ------------------------------------------------------------------------------
# 4. SIMULATORE GATEWAY CARTE (WireMock Standalone / Embedded)
# ------------------------------------------------------------------------------
WIREMOCK_SERVER_PORT=8089

# ------------------------------------------------------------------------------
# 5. PAYPAL SMART PAYMENT BUTTONS & CHECKOUT SDK
# ------------------------------------------------------------------------------
# Inserisci le credenziali Sandbox da developer.paypal.com per testare pagamenti reali
PAYPAL_CLIENT_ID=mock_client_id
PAYPAL_CLIENT_SECRET=mock_client_secret
PAYPAL_API_URL=https://api-m.sandbox.paypal.com

# ------------------------------------------------------------------------------
# 6. NOTIFICHE EMAIL & SMTP (Google Workspace / Gmail App Password)
# ------------------------------------------------------------------------------
# Per generare una password per le app Gmail:
# Account Google -> Sicurezza -> Verifica in due passaggi -> Password per le app
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_16_character_app_password
STAYHUB_MAIL_FROM=StayHub Reservations <your_email@gmail.com>
STAYHUB_MAIL_ENABLED=true

# ------------------------------------------------------------------------------
# 7. FILE STORAGE (Upload Locale Immagini Camere)
# ------------------------------------------------------------------------------
STAYHUB_UPLOAD_DIR=uploads/rooms
